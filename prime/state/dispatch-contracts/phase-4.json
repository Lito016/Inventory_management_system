  "gate_contracts": [
    {
      "id": "G1",
      "outcome": "implementation plan identifies risks, dependencies, and constraints",
      "check": "node scripts/gate-check.mjs pattern docs/PRP.md \"risk|dependency|constraint|assumption|prerequisite\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G2",
      "outcome": "plan report records specification decisions",
      "check": "node scripts/gate-check.mjs size prime/reports/phase-4-plan.md 200",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G3",
      "outcome": "implementation plan contains ordered steps or milestones",
      "check": "node scripts/gate-check.mjs pattern docs/PRP.md \"step|phase|milestone|task|stage|order\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G4",
      "outcome": "quality audit verdict is recorded for phase artifacts",
      "check": "node scripts/gate-check.mjs pattern prime/reports/phase-4-quality-review.md \"verdict:\\s*(pass|block|request changes)\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G5",
      "outcome": "plan contains effort estimates or time projections",
      "check": "node scripts/gate-check.mjs pattern docs/PRP.md \"estimate|hour|day|week|PERT|effort|duration|timeline\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G6",
      "outcome": "plan contains verification points or acceptance criteria per milestone",
      "check": "node scripts/gate-check.mjs pattern docs/PRP.md \"verif|accept|criteria|done|complete|check|test|deliverable\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G9",
      "outcome": "plan traces implementation tasks to requirements and design decisions",
      "check": "node scripts/gate-check.mjs pattern docs/PRP.md \"PRD|DESIGN|REQ-[0-9]+|design decision|acceptance criterion\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    },
    {
      "id": "G11",
      "outcome": "mid-phase checkpoint evidence demonstrates plan defects were corrected before execution",
      "check": "node scripts/gate-check.mjs pattern prime/reports/phase-4-checkpoint-review.md \"artifact snapshot|finding|correction|blocker|verdict\"",
      "expect": "GATE-PASS",
      "kind": "runnable"
    }
  ]
}
